{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rustwallhub",
  "version": "2.1.0",
  "identifier": "com.rustwallhub.app",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RustWallhub - 壁纸管理器",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: http://asset.localhost blob: data: https://th.wallhaven.cc; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/rustwallhub/**",
          "$HOME/Pictures/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/Synneither/RustWallhub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGMzNBMjRBRTZERUNFM0MKUldROHp0N21TcUl6ZitJUTROMGFhSDh1Q1B0YVlGRDZja28wMUNGUXFlQ2VnNC8xVW5FWTJWRkYK"
    }
  }
}
